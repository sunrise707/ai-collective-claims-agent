# Local run (npm run start:dev). Rename this file to .env and start: it works as is, with no database and no API key.

# memory = no database needed (data is lost on restart); postgres = needs DATABASE_URL below and `npx prisma migrate deploy`
STORAGE=memory
DATABASE_URL=postgresql://claims:claims@localhost:5432/claims

PORT=3000
LOG_LEVEL=info
DUPLICATE_SIMILARITY_THRESHOLD=0.6

# LLM: leave all keys empty to run offline (deterministic heuristics, no LLM calls).
# Claude is used when ANTHROPIC_API_KEY is set; OpenAI (or compatible) when only OPENAI_API_KEY is set.
LLM_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

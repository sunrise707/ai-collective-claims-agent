# Docker Compose (docker compose up --build). Rename this file to .env and start: it works as is, with PostgreSQL
# in a container and no API key. The database settings are already set in docker-compose.yml.

# LLM: leave all keys empty to run offline (deterministic heuristics, no LLM calls).
# Claude is used when ANTHROPIC_API_KEY is set; OpenAI (or compatible) when only OPENAI_API_KEY is set.
LLM_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
